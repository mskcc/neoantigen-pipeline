// multievolve_walltime.config
//
// Sets PHYLOWGS_MULTIEVOLVE walltime per sample instead of a flat 29 days.
// Derived from 4048 completed samples -- see analysis/RUNTIME_SCALING.md.
//
// The directive evaluates a 99th-PERCENTILE walltime directly (quantile
// regression, tau=0.99), rather than predicting the mean and multiplying by a
// flat safety factor:
//
//     ln(walltime_sec) = 9.260761
//                      - 1.338508*ln(sB) + 0.117911*ln(sB)^2
//                      - 0.213557*ln(cB) + 0.036649*ln(cB)^2
//
//     sB = ssm_data.txt size in bytes,  cB = cnv_data.txt size in bytes
//
// WHY QUANTILE REGRESSION, not mean-model x margin?
//   Residual spread grows with sample size, so a flat margin silently
//   under-protects the big samples -- exactly the ones that cost days. Measured
//   coverage of a flat 1.79x margin vs this fit:
//
//       mutations      n     flat     qreg
//         0-100     1267    99.1%    99.1%
//       100-300     1723    99.3%    98.7%
//      300-1000      733   100.0%    99.6%
//     1000-3000      255    98.8%    99.6%
//     3000-10000      65    84.6%    96.9%     <-- flat margin fails here
//    10000-30000       5    20.0%   100.0%     <-- and fails badly here
//
//   The quantile fit is also slightly CHEAPER: median over-request 1.73x vs
//   1.77x (and vs ~1735x for the flat 29.d setting).
//
// WHY FILE SIZES, not mutation count and FGA?
//   1. Nextflow directive closures cannot read file CONTENT. Input files arrive
//      as nextflow.processor.TaskPath, whose toAbsolutePath() throws
//      UnsupportedOperationException and whose readers throw
//      ProviderMismatchException. Only size()/exists() work -- size() is the
//      documented pattern for dynamic resources. (Verified empirically.)
//   2. It is not a compromise: ln(ssm_bytes) tracks ln(n_ssm) at r = 0.9998,
//      and cnv_data.txt's size encodes CNV count *and* their SSM load, which
//      predicts better than FGA alone (R2 0.953 vs 0.939 on the mean model).
//
// Both inputs are the process's OWN declared inputs -- multievolve receives
// `tuple val(meta), path(cnv_data), path(ssm_data)` -- so no module,
// subworkflow, or storeDir changes are needed.
//
// Usage (load AFTER multievolve_29days.config -- both set the same directive
// and the last one loaded wins):
//     nextflow run ... \
//         -c storeDir_stringfix.config \
//         -c shortqueue.config \
//         -c override_single.config \
//         -c /data1/core006/ccs_pipelines/NeoQual_test/analysis/multievolve_walltime.config
//
// Tuning:
//     --mv_safety 1.5     extra headroom on top of the 99th percentile
//     --mv_safety 0.56    ~ back down to the mean prediction (1/1.79)

// ---------------------------------------------------------------- parameters
params.mv_safety     = 1.0   // multiplier on the 99th-percentile estimate
params.mv_min_hours  = 1     // floor
params.mv_max_hours  = 168   // ceiling = 7.d -- cmobic_cpu's actual MaxTime (confirmed via
                              // `scontrol show partition cmobic_cpu`); requesting above this
                              // gets the sbatch submission rejected outright (empty workdir,
                              // no .command.log), not a walltime kill after running.
params.mv_fallback_h = 168   // used if a size is unavailable

def mvWalltime = { ssmFile, cnvFile, attempt ->
    double h
    try {
        double sB = ssmFile.size()
        double cB = cnvFile.size()
        if (sB <= 0 || cB <= 0) throw new IllegalStateException("zero-size input")
        double lb = Math.log(sB)
        double lc = Math.log(cB)
        double secs = Math.exp(9.260761d
                               - 1.338508d * lb + 0.117911d * lb * lb
                               - 0.213557d * lc + 0.036649d * lc * lc)
        h = (secs / 3600.0d) * (params.mv_safety as double)
    }
    catch (Throwable e) {
        System.err.println "[multievolve_walltime] prediction failed (${e}); " +
                           "falling back to ${params.mv_fallback_h}h"
        h = params.mv_fallback_h as double
    }
    // Double the allowance on each retry so a bad estimate self-corrects rather
    // than looping on exit 140. Pairs with override_single.config's retry logic.
    h = h * Math.pow(2.0d, (attempt as int) - 1)
    h = Math.max(h, params.mv_min_hours as double)
    h = Math.min(h, params.mv_max_hours as double)
    return "${(long) Math.ceil(h)}h" as nextflow.util.Duration
}

process {
    // The iris profile's resourceLimits map is captured at parse time and caps
    // time at 7.d; restate it wholesale or any prediction above 7 days is
    // silently clamped. Must match iris max_cpus (92) / max_memory (950.GB).
    // time capped at 7.d to match cmobic_cpu's actual MaxTime -- see mv_max_hours above.
    resourceLimits = [ cpus: 92, memory: 950.GB, time: 7.d ]

    withName: 'PHYLOWGS_MULTIEVOLVE' {
        time = { mvWalltime(ssm_data, cnv_data, task.attempt) }
    }

    // Same input files (ssm_data, cnv_data) drive the estimate regardless of
    // engine -- the fit is on input size, not multievolve's own runtime, so it
    // carries over as a starting point for phylowgs-go until Go has its own
    // runtime-scaling data to fit against.
    withName: 'PHYLOWGS_MULTIEVOLVEGO' {
        time = { mvWalltime(ssm_data, cnv_data, task.attempt) }
    }
}
