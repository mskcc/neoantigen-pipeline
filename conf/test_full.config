/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running tests without PhyloWGS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Identical to test.config but with run_phylowgs = false to verify the pipeline
    runs correctly when PhyloWGS is skipped and stub outputs are used.

    Use as follows:
        nextflow run mskcc/neoqual-nf -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

nextflow.enable.moduleBinaries = true

includeConfig 'test.config'

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset with PhyloWGS'
    run_phylowgs = true
}
