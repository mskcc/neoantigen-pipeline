/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests against phylowgs-go only
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Identical to test_full.config but runs only the phylowgs-go engine (skips the
    Python/C++ multievolve step). PHYLOWGS_MULTIEVOLVEGO pulls orgeraj/phylowgs-go:go-port
    from Docker Hub (multi-arch: linux/amd64 + linux/arm64) until the image is published
    to ghcr under mskcc-omics-workflows.

    Use as follows:
        nextflow run mskcc/neoantigenpipeline -profile test_go,docker --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

nextflow.enable.moduleBinaries = true

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '6.h'
    ]
}

params {
    config_profile_name        = 'Test profile (phylowgs-go only)'
    config_profile_description = 'Minimal test dataset run through phylowgs-go only'

    // Input data
    input  = "${projectDir}/assets/samplesheet.csv"

    // Genome references
    genome = 'GRCh37'
    run_phylowgs = true
    phylowgs_engine = 'go'
    phylo_burnin_samples = 2
    phylo_mcmc_samples = 2
    phylo_num_chains = 2
    netmhc3 = true
    kd_cutoff = 500
    compute_fitness_a = 22.897590714815188
    compute_fitness_k = 1
    compute_fitness_w = 0.22402192838740312

    mutalyzer_cache_dir = "${params.outdir}/mutalyzer_cache"

    iedbfasta = 'https://raw.githubusercontent.com/mskcc-omics-workflows/test-datasets/neoantigen/neoantigen/neoantigenEditing/data/iedb.fasta'
    reference_fasta = 'https://github.com/mskcc-omics-workflows/test-datasets/raw/neoantigen/neoantigen/small_test_chr2and16/Homo_sapiens.GRCh37.dna_rm.chromosome.chr2_16.fa.bgzip.gz'
    reference_gff3  = 'https://github.com/mskcc-omics-workflows/test-datasets/raw/neoantigen/neoantigen/small_test_chr2and16/Homo_sapiens.GRCh37.87.chr2_16.gff3'
    cdna = 'https://github.com/mskcc-omics-workflows/test-datasets/raw/neoantigen/neoantigen/Homo_sapiens.GRCh37.75.cdna.all.fa.gz'
    gtf = 'https://github.com/mskcc-omics-workflows/test-datasets/raw/neoantigen/neoantigen/Homo_sapiens.GRCh37.75.gtf.gz'
}
