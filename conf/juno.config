/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run mskcc/neoantigenpipeline -profile prod,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

nextflow.enable.moduleBinaries = true

includeConfig 'prod.config'

process {
    beforeScript = "module load singularity/3.7.1; unset R_LIBS; catch_term () { echo 'caught USR2/TERM signal'; set +e; false; on_exit ; } ; trap catch_term USR2 TERM"
    maxRetries = 3
    executor = 'lsf'
    queueSize = 500
    perJobMemLimit = true
    // `time` raised from 100.h so it no longer clamps PHYLOWGS_MULTIEVOLVE's
    // escalation (see conf/base.config), which reaches 360.h on attempt 3.
    // The old ceiling capped every retry at ~4d4h, far short of the documented
    // 5-day and 14-day multievolve runtimes.
    resourceLimits = [
        cpus: 5,
        memory: '10.GB',
        time: '360.h'
    ]
}

params {
    config_profile_name        = 'Prod Juno profile'
    config_profile_description = 'Minimal conf to run the pipeline'

    mutalyzer_cache_dir = '/juno/work/ccs/neoantigen/mutalyzer_cache'

    reference_fasta = '/juno/work/ccs/neoantigen/Homo_sapiens.GRCh37.dna.toplevel.fa.bgzip.gz'
    reference_gff3  = '/juno/work/ccs/neoantigen/Homo_sapiens.GRCh37.87.gff3'
    cdna = '/juno/work/ccs/neoantigen/Homo_sapiens.GRCh37.87.cdna.all.fa.gz'
    gtf = '/juno/work/ccs/neoantigen/Homo_sapiens.GRCh37.87.gtf.gz'
}
