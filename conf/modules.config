/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    publishDir = [
        path: { "${params.outdir}/${task.tag}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'MUTALYZER_RETRIEVER' {
        storeDir = "${params.mutalyzer_cache_dir}"
    }

    withName: 'PHYLOWGS_PARSECNVS' {
        ext.args = '-f facets'
    }

    withName: 'PHYLOWGS_MULTIEVOLVE' {
        ext.args = "--burnin-samples ${params.phylo_burnin_samples} --mcmc-samples ${params.phylo_mcmc_samples} --num-chains ${params.phylo_num_chains} --write-state-every 500 --write-backups-every 2000"
    }

    withName: 'PHYLOWGS_WRITERESULTS' {
        ext.args = '--max-multiprimary 1.0 --include-multiprimary'
    }

    withName: 'PHYLOWGS_MULTIEVOLVEGO' {
        ext.args = "-B ${params.phylo_burnin_samples} -s ${params.phylo_mcmc_samples} -j ${params.phylo_num_chains}"
    }

    withName: 'PHYLOWGS_WRITERESULTSGO' {
        ext.args = '--max-multiprimary 1.0'
        ext.prefix = { "${meta.id}-go" }
    }

    withName: 'NEOANTIGENUTILS_NEOANTIGENINPUT' {
        ext.args = "--kD_cutoff ${params.kd_cutoff}"
    }

    withName: 'NEOANTIGENEDITING_COMPUTEFITNESS' {
        // TEMPORARY: compute_fitness.py's CLI changed when modules#258 switched this
        // module from its own resources/usr/bin/ copy to the one baked into
        // neoantigen-editing:1.1. --a_param/--k_param/--w_param no longer exist --
        // the script now hardcodes a/k/w to these same default values internally --
        // and a new required --kd_cutoff_fitness controls which neoantigens are
        // eligible to be attached to a clone for fitness purposes at all (distinct
        // from params.kd_cutoff, which filters weak binders earlier, at
        // NEOANTIGENUTILS_NEOANTIGENINPUT). params.compute_fitness_a/k/w are
        // currently unused as a result -- restore passing them if/when the script
        // regains those flags.
        ext.args = "--kd_cutoff_fitness ${params.compute_fitness_kd_cutoff}"
    }

    withName: 'GENERATEMUTFASTA' {
        containerOptions = '--network none'
    }
}
